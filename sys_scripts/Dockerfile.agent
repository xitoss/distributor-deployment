FROM python:3.12-alpine

WORKDIR /workspace
ENV PYTHONPATH=/workspace

# Copy and install agent dependencies
COPY sys_scripts/requirements.txt /workspace/sys_scripts/requirements.txt
RUN pip install --no-cache-dir -r /workspace/sys_scripts/requirements.txt

# Install docker-cli (needed for backup/restore)
RUN apk add --no-cache docker-cli

# Copy agent code and .env
COPY sys_scripts /workspace/sys_scripts
COPY .env /workspace/.env

CMD ["python3", "sys_scripts/deploy_agent.py"]
